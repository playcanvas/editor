[
    {
        "name": "npot png rounds each axis",
        "pow2": true,
        "meta": { "format": "png", "width": 20, "height": 12, "alpha": false, "depth": 8 },
        "expected": { "format": "png", "size": { "width": 16, "height": 16 } }
    },
    {
        "name": "pot png is untouched",
        "pow2": true,
        "meta": { "format": "png", "width": 16, "height": 16, "alpha": false, "depth": 8 },
        "expected": { "format": "png" }
    },
    {
        "name": "pow2 rounds at the log2 midpoint",
        "pow2": true,
        "meta": { "format": "jpeg", "width": 1449, "height": 1448, "alpha": false, "depth": 8 },
        "expected": { "format": "jpeg", "size": { "width": 2048, "height": 1024 } }
    },
    {
        "name": "jpg is normalized to jpeg",
        "pow2": false,
        "meta": { "format": "jpg", "width": 64, "height": 64, "alpha": false, "depth": 8 },
        "expected": { "format": "jpeg" }
    },
    {
        "name": "opaque tga becomes jpeg",
        "pow2": false,
        "meta": { "format": "tga", "width": 20, "height": 12, "alpha": false, "depth": 8 },
        "expected": { "format": "jpeg" }
    },
    {
        "name": "alpha tga becomes png",
        "pow2": false,
        "meta": { "format": "tga", "width": 20, "height": 12, "alpha": true, "depth": 8 },
        "expected": { "format": "png" }
    },
    {
        "name": "16-bit png is depth converted",
        "pow2": false,
        "meta": { "format": "png", "width": 32, "height": 32, "alpha": false, "depth": 16 },
        "expected": { "format": "png", "depthConvert": true }
    },
    {
        "name": "hdr becomes rgbm png",
        "pow2": true,
        "meta": { "format": "hdr", "width": 64, "height": 32, "alpha": false, "depth": 32 },
        "expected": { "format": "png", "rgbm": true }
    },
    {
        "name": "npot exr becomes rgbm png with a size",
        "pow2": true,
        "meta": { "format": "exr", "width": 60, "height": 30, "alpha": false, "depth": 32 },
        "expected": { "format": "png", "rgbm": true, "size": { "width": 64, "height": 32 } }
    },
    {
        "name": "16-bit tiff becomes rgbm png",
        "pow2": false,
        "meta": { "format": "tiff", "width": 8, "height": 8, "alpha": false, "depth": 16 },
        "expected": { "format": "png", "rgbm": true }
    },
    {
        "name": "webp keeps its format",
        "pow2": true,
        "meta": { "format": "webp", "width": 30, "height": 30, "alpha": true, "depth": 8 },
        "expected": { "format": "webp", "size": { "width": 32, "height": 32 } }
    },
    {
        "name": "gif keeps its format",
        "pow2": false,
        "meta": { "format": "gif", "width": 8, "height": 8, "alpha": false, "depth": 8 },
        "expected": { "format": "gif" }
    },
    {
        "name": "10-bit avif is depth converted in place",
        "pow2": false,
        "meta": { "format": "avif", "width": 16, "height": 16, "alpha": false, "depth": 10 },
        "expected": { "format": "avif", "depthConvert": true }
    }
]
